# Copy to .env and fill in real values. Never commit .env.
PORT=5000
# Public base URL used in tracking-pixel and unsubscribe links inside emails
PUBLIC_BASE_URL=http://localhost:5000
# Local Postgres or a hosted one such as Neon (append ?sslmode=require for hosted)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stylesense_ai
# Used only by `npm test` - must be a SEPARATE database, the API tests truncate its tables
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stylesense_ai_test

# Email: "log" (prints to console, no real send) or "resend"
EMAIL_PROVIDER=log
EMAIL_FROM=StyleSense AI <onboarding@resend.dev>
# When set, every email is redirected here so no real prospect is ever emailed (required for real providers)
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=

# LLM (any OpenAI-compatible chat-completions API, e.g. Groq or Gemini free tier). Leave blank to disable.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional, for reasoning models such as gpt-oss: low | medium | high (low keeps free-tier token use down)
LLM_REASONING_EFFORT=low
# Web search for lead discovery (Tavily free tier)
SEARCH_API_KEY=


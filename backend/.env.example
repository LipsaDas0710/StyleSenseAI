# Copy to .env and fill in real values. Never commit .env.
PORT=5000
# Public base URL used in tracking-pixel and unsubscribe links inside emails
PUBLIC_BASE_URL=http://localhost:5000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/stylesense_ai
# Used only by `npm test` (the API test truncates its tables)
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/stylesense_ai_test

# Email: "log" (prints to console, no real send) or "resend"
EMAIL_PROVIDER=log
EMAIL_FROM=StyleSense AI <onboarding@resend.dev>
# Every outreach email is redirected here during development so no real prospect is ever emailed
EMAIL_TEST_RECIPIENT=you@example.com
RESEND_API_KEY=

# LLM (any OpenAI-compatible chat-completions API, e.g. Groq or Gemini free tier). Leave blank to disable.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Web search for lead discovery (Tavily free tier)
SEARCH_API_KEY=
